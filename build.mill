package build

import mill._
import mill.scalalib._
import publish._


trait Base extends ScalaModule {
  def scalaVersion = "3.8.4"

  // scaladoc 3.8.x has a parallel-rendering race (SignatureBuilder NPE) that maths trips on
  // nearly every run and other modules occasionally; 3.9 fixes it.  Override the doc tool
  // only -- the compiler stays at scalaVersion until 3.9.0 final (3.9.0-RC6 verified clean
  // against the full build and test suite).  Drop this override when scalaVersion reaches 3.9.
  override def scalaDocClasspath = Task {
    defaultResolver().classpath(Seq(mvn"org.scala-lang:scaladoc_3:3.9.0-RC6")) ++ super.scalaDocClasspath()
  }

  def scalacOptions = Seq(
    "-deprecation",
    "-Wnonunit-statement",
    "-Wvalue-discard",
    "-Wconf:msg=is not declared infix:s",
    "-Wconf:msg=Illegal literal:s",
    "-release", "25"      // require JDK 25+: stable Foreign Function & Memory API (22) + non-pinning
                          // synchronized for virtual threads (24), used by Mem/SharedMemory/Fu
  )
}


trait PublishKse3 extends SonatypeCentralPublishModule {
  def publicationName: String = ""

  override def artifactName = {
    if (publicationName.isEmpty) "kse3-" + super.artifactName()
    else publicationName
  }

  def publishVersion = "0.9.0"

  def pomSettings = PomSettings(
    description = "Kerr Scala Extensions 3, module " + artifactName(),
    organization = "com.github.ichoran",
    url = "https://github.com/ichoran/kse3",
    licenses = Seq(License.`BSD-3-Clause-Clear`),
    versionControl = VersionControl.github("ichoran", "kse3"),
    developers = Seq(
      Developer("ichoran", "Rex Kerr", "https://github.com/ichoran")
    )
  )
}


trait Common extends Base {
  def extraTestDeps: Seq[ScalaModule] = Seq.empty
  def extraTestIvy: T[Seq[Dep]] = Task{ Seq.empty[Dep] }

  object test extends ScalaTests with TestModule.Junit4 {
    override def mvnDeps = Task {
      super.mvnDeps() ++ extraTestIvy()
    }
    def moduleDeps = extraTestDeps ++ super.moduleDeps
    def forkArgs = Task { Seq("--enable-native-access=ALL-UNNAMED") }   // FFM native paths (SharedMemory, FdSock)
  }
}


object basics extends Common with PublishKse3 {}

object flow extends Common with PublishKse3 {
  def moduleDeps = Seq(basics)
  object bench extends ScalaTests with TestModule.Junit4 {}
}

object maths extends Common with PublishKse3 {
  def moduleDeps = Seq(basics)
  override def extraTestDeps = Seq(flow)
}

object loom extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths)
}

object thyme extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths)
}

object eio extends Common with PublishKse3 {
  def moduleDeps = Seq(flow, maths)
  override def extraTestDeps = Seq(loom)
  override def extraTestIvy = Task { Seq(
    mvn"com.github.marschall:memoryfilesystem:2.5.0"
  ) }
}

object jsaun extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths, eio)
}

object foundation extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths, loom, eio, thyme, jsaun)
}

object twodee extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths, eio)
}

object alien extends Common with PublishKse3 {
  def moduleDeps = Seq(basics, flow, maths, loom, eio)
  override def extraTestIvy = Task { Seq(
    mvn"com.google.protobuf:protobuf-java:4.28.3"   // differential oracle for the Pb wire codec; test-only
  ) }
}

object all extends Common {
  override def mvnDeps = Task {
    super.mvnDeps() ++
    Seq(
      mvn"org.typelevel::cats-core:2.12.0",
      mvn"com.diffplug.matsim:matfilerw:3.1.1",
      mvn"com.lihaoyi::upickle:4.1.0",
      mvn"it.unimi.dsi:fastutil:8.5.16",
      mvn"com.twelvemonkeys.imageio:imageio-tiff:3.10.1"
    )
  }
  def moduleDeps = Seq(foundation, twodee, alien)
}
